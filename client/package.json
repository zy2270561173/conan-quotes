{
  "name": "conan-quotes-admin",
  "productName": "柯南名言管理后台",
  "version": "1.0.0",
  "description": "名侦探柯南名言管理系统后台管理工具",
  "main": "electron/main.cjs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --win --dir",
    "electron:dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.16.1",
    "echarts": "^6.0.0",
    "element-plus": "^2.14.0",
    "express": "^5.2.1",
    "vue": "^3.5.34",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "pkg": "^5.8.1",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "cn.muysky.conan-quotes-admin",
    "productName": "柯南名言管理后台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
